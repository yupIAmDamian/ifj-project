import ifj26.*

@main def run(): Unit =
    val empty: String = ""
    val one: String = "a"
    val emptyPart: String = subStr(one, 0, 0)
    val lastPart: String = subStr(one, 0, 1)
    val lastCode: Int = ord(one, 0)
    print(strLength(empty))
    print("\n")
    print(emptyPart)
    print("\n")
    print(lastPart)
    print("\n")
    print(lastCode)
    print("\n")
