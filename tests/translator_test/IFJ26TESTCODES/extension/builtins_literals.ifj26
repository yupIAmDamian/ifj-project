import ifj26.*

@main def run(): Unit =
    print("builtins: arithmetic and literals\n")
    val i: Int = 42
    val d: Double = 3.75
    val s: String = "hello"
    print(i)
    print("\n")
    print(d)
    print("\n")
    print(s)
    print("\n")
    print(i + 8)
    print("\n")
    print(d * 2.0)
    print("\n")
