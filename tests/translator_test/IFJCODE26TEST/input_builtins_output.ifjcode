.IFJcode26
JUMP main

LABEL main
DEFVAR LF@line$2$main
DEFVAR LF@number$2$main
DEFVAR LF@real$2$main
READ LF@line$2$main string
JUMPIFNEQ $read$ok$0 LF@line$2 nil@nil
MOVE LF@line$2 string@
LABEL $read$ok$0
READ LF@number$2$main int
JUMPIFNEQ $read$ok$1 LF@number$2 nil@nil
MOVE LF@number$2 int@0
LABEL $read$ok$1
READ LF@real$2$main float
JUMPIFNEQ $read$ok$2 LF@real$2 nil@nil
MOVE LF@real$2 float@0x0p+0
LABEL $read$ok$2
WRITE LF@line$2$main
WRITE LF@number$2$main
WRITE LF@real$2$main
WRITE string@\010
EXIT int@0

