LABEL ord
CREATEFRAME
PUSHFRAME
DEFVAR LF@ord$value
DEFVAR LF@ord$index
DEFVAR LF@ord$length
DEFVAR LF@ord$char
DEFVAR LF@ord$result
DEFVAR LF@ord$tmp
DEFVAR LF@ord$invalid
POPS LF@ord$value
POPS LF@ord$index
STRLEN LF@ord$length LF@ord$value
MOVE LF@ord$invalid bool@false
LT LF@ord$tmp LF@ord$index int@0
OR LF@ord$invalid LF@ord$invalid LF@ord$tmp
GT LF@ord$tmp LF@ord$index LF@ord$length
OR LF@ord$invalid LF@ord$invalid LF@ord$tmp
EQ LF@ord$tmp LF@ord$index LF@ord$length
OR LF@ord$invalid LF@ord$invalid LF@ord$tmp
JUMPIFEQ $ord$invalid LF@ord$invalid bool@true
GETCHAR LF@ord$char LF@ord$value LF@ord$index
STRI2INT LF@ord$result LF@ord$char int@0
PUSHS LF@ord$result
POPFRAME
RETURN
LABEL $ord$invalid
