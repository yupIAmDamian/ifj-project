.IFJcode26
JUMP main

LABEL factorialIterative
CREATEFRAME
PUSHFRAME
DEFVAR LF@$tmp
DEFVAR LF@factorialIterative$n$2
DEFVAR LF@factorialIterative$result$2
DEFVAR LF@factorialIterative$i$2
POPS LF@factorialIterative$n$2
PUSHS int@1
POPS LF@factorialIterative$result$2
PUSHS int@2
POPS LF@factorialIterative$i$2
LABEL $factorialIterative$while$0$start
PUSHS LF@factorialIterative$i$2
PUSHS LF@factorialIterative$n$2
GTS
NOTS
PUSHS bool@false
JUMPIFEQS $factorialIterative$while$0$end
PUSHS LF@factorialIterative$result$2
PUSHS LF@factorialIterative$i$2
MULS
POPS LF@factorialIterative$result$2
PUSHS LF@factorialIterative$i$2
PUSHS int@1
ADDS
POPS LF@factorialIterative$i$2
JUMP $factorialIterative$while$0$start
LABEL $factorialIterative$while$0$end
PUSHS LF@factorialIterative$result$2
POPFRAME
RETURN

LABEL factorialRecursive
CREATEFRAME
PUSHFRAME
DEFVAR LF@$tmp
DEFVAR LF@factorialRecursive$n$4
DEFVAR LF@factorialRecursive$previous$6
DEFVAR LF@factorialRecursive$smaller$6
POPS LF@factorialRecursive$n$4
PUSHS LF@factorialRecursive$n$4
PUSHS int@1
GTS
NOTS
PUSHS bool@false
JUMPIFEQS $factorialRecursive$if$1$else
PUSHS int@1
POPFRAME
RETURN

LABEL $factorialRecursive$if$1$else
PUSHS LF@factorialRecursive$n$4
PUSHS int@1
SUBS
POPS LF@factorialRecursive$previous$6
PUSHS LF@factorialRecursive$previous$6
CALL factorialRecursive
POPS LF@factorialRecursive$smaller$6
PUSHS LF@factorialRecursive$n$4
PUSHS LF@factorialRecursive$smaller$6
MULS
POPFRAME
RETURN

LABEL $factorialRecursive$if$1$end
POPFRAME
RETURN

LABEL main
DEFVAR GF@$tmp
DEFVAR GF@factorialExample$n$7
DEFVAR GF@factorialExample$iterative$11
DEFVAR GF@factorialExample$recursive$11
READ GF@$tmp int
JUMPIFNEQ $read$ok$2 GF@$tmp nil@nil
MOVE GF@$tmp int@0
LABEL $read$ok$2
PUSHS GF@$tmp
POPS GF@factorialExample$n$7
PUSHS GF@factorialExample$n$7
PUSHS int@0
LTS
PUSHS bool@false
JUMPIFEQS $main$if$3$else
PUSHS string@Use\032an\032integer\032from\0320\032to\03212.\010
POPS GF@$tmp
WRITE GF@$tmp
JUMP $main$if$3$end
LABEL $main$if$3$else
PUSHS GF@factorialExample$n$7
PUSHS int@12
GTS
PUSHS bool@false
JUMPIFEQS $main$if$4$else
PUSHS string@Use\032an\032integer\032from\0320\032to\03212.\010
POPS GF@$tmp
WRITE GF@$tmp
JUMP $main$if$4$end
LABEL $main$if$4$else
PUSHS GF@factorialExample$n$7
CALL factorialIterative
POPS GF@factorialExample$iterative$11
PUSHS GF@factorialExample$n$7
CALL factorialRecursive
POPS GF@factorialExample$recursive$11
PUSHS string@iterative:\032
POPS GF@$tmp
WRITE GF@$tmp
PUSHS GF@factorialExample$iterative$11
POPS GF@$tmp
WRITE GF@$tmp
PUSHS string@\010recursive:\032
POPS GF@$tmp
WRITE GF@$tmp
PUSHS GF@factorialExample$recursive$11
POPS GF@$tmp
WRITE GF@$tmp
PUSHS string@\010
POPS GF@$tmp
WRITE GF@$tmp
LABEL $main$if$4$end
LABEL $main$if$3$end
EXIT int@0

