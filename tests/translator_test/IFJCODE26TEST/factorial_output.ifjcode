OR LF@substr$invalid LF@substr$invalid LF@substr$tmp
GT LF@substr$tmp LF@substr$start LF@substr$length
OR LF@substr$invalid LF@substr$invalid LF@substr$tmp
EQ LF@substr$tmp LF@substr$start LF@substr$length
OR LF@substr$invalid LF@substr$invalid LF@substr$tmp
GT LF@substr$tmp LF@substr$end LF@substr$length
OR LF@substr$invalid LF@substr$invalid LF@substr$tmp
JUMPIFEQ $substr$error LF@substr$invalid bool@true
MOVE LF@substr$result string@
MOVE LF@substr$index LF@substr$start
LABEL $substr$loop
JUMPIFEQ $substr$done LF@substr$index LF@substr$end
GETCHAR LF@substr$char LF@substr$value LF@substr$index
